# Spotify API Credentials (secrets – must be set here or as env vars)
SPOTIFY_CLIENT_ID= {your_client_id_here}
SPOTIFY_CLIENT_SECRET= {your_client_secret_here}
# For redirect URI, localhost is prohibited by Spotify. Use your actual loopback address instead (or an https URL).
SPOTIFY_REDIRECT_URI= {your_redirect_uri_here}

# Spotify Playlist IDs
SPOTIFY_ALL_PLAYLIST_ID= {your_all_playlist_id_here}
SPOTIFY_FREQUENT_PLAYLIST_ID= {your_frequent_playlist_id_here}

# All other settings (thresholds, paths, logging, etc.) are in
# src/config/config.yaml. Any value there can be overridden by
# setting the corresponding env var – see the comments in that file.
