# Spotify API Credentials
SPOTIFY_CLIENT_ID= {your_client_id_here}
SPOTIFY_CLIENT_SECRET= {your_client_secret_here}
# For redirect URI, localhost is prehibited by Spotify. Use your actual loopback address instead (or obviously an https URL).
SPOTIFY_REDIRECT_URI= {your_redirect_uri_here}


# Spotify Playlist IDs
SPOTIFY_ALL_PLAYLIST_ID= {your_all_playlist_id_here}
SPOTIFY_FREQUENT_PLAYLIST_ID= {your_frequent_playlist_id_here}

# Feature Configuration Settings
FREQUENT_MIN_PLAYS=5

# Program Configuration Settings
DB_PATH=./data/spotify.db
LOG_LEVEL=INFO
LOG_FILE=./data/logs/spotify.log
LOG_RETENTION_DAYS=7
