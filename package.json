{
  "name": "spotify-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "dev": "npm run configure && wrangler dev -c wrangler.generated.toml --env test --test-scheduled",
    "deploy": "npm run configure && wrangler deploy -c wrangler.generated.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "token": "tsx scripts/token.ts",
    "import-history": "tsx scripts/import-history.ts",
    "live-write-test": "tsx scripts/live-write-test.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261006.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
