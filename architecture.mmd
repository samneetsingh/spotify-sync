flowchart TB
  %% ========= Entry + Scheduling =========
  subgraph SCHEDULER["Scheduler Layer"]
    CRON["cron / systemd timer / n8n
(runs: poetry run spotify sync)"]
  end

  subgraph APP["Python App (src/)"]
    MAIN["main.py
CLI dispatcher"]
    CFG["config.py
loads env + settings"]
    LOG["logging_setup.py
logging config"]

    CRON --> MAIN
    MAIN --> CFG
    MAIN --> LOG
  end

  %% ========= DB Platform =========
  subgraph DBP["DB Platform (src/db/)"]
    CONN["connection.py
opens sqlite + manages migrations"]
    SCHEMA["schema.py
defines tables / migrations"]
    STATE["state.py
cursor + kv state"]
    QUERIES["queries.py
reusable queries (loads sql/ files)"]
    SQL["db/sql/*.sql
stored SQL snippets"]
  end

  CFG --> CONN
  CONN --> SCHEMA
  MAIN --> CONN
  QUERIES --> SQL

  %% ========= Spotify Wrapper =========
  subgraph ING["Ingestion (src/ingestion/)"]
    SPCL["spotify_client.py
Spotipy wrapper + auth manager"]
    SYNC["sync_recent.py
recently-played -> DB
adds to Liked Songs
updates frequent playlist"]
    BACKFILL["backfill_playlist.py
cache existing playlist content"]
    IMPORT["history_import.py
import Spotify history JSON"]
  end

  MAIN --> SPCL
  MAIN --> SYNC
  MAIN --> BACKFILL
  MAIN --> IMPORT
  SPCL --> SYNC
  SPCL --> BACKFILL

  %% Ingestion writes to DB
  SYNC -->|write plays/tracks| CONN
  SYNC -->|read/write cursor| STATE
  STATE --> CONN
  BACKFILL -->|write tracks/playlist cache| CONN
  IMPORT -->|write plays/tracks| CONN

  %% ========= Analytics =========
  subgraph ANA["Analytics (src/analytics/)"]
    TSTATS["track_stats.py
compute/refresh aggregates"]
    ASTATS["artist_stats.py
compute/refresh aggregates"]
  end

  %% Analytics reads DB and writes derived tables (optional)
  QUERIES --> TSTATS
  QUERIES --> ASTATS
  CONN --> QUERIES
  TSTATS -->|write derived tables| CONN
  ASTATS -->|write derived tables| CONN

  %% ========= Features =========
  subgraph FEAT["Features (src/features/)"]
    ALLPL["all_playlist.py
legacy mirror (not primary)"]
    ARTPL["artist_playlists.py
generate per-artist playlists"]
    YEARPL["yearly_playlists.py
generate yearly playlists"]
  end

  %% Features read DB/analytics and write to Spotify
  MAIN --> ALLPL
  MAIN --> ARTPL
  MAIN --> YEARPL

  ALLPL --> QUERIES
  ARTPL --> QUERIES
  YEARPL --> QUERIES

  ALLPL --> TSTATS
  ARTPL --> ASTATS
  YEARPL --> TSTATS

  ALLPL -->|Spotify writes| SPCL
  ARTPL -->|Spotify writes| SPCL
  YEARPL -->|Spotify writes| SPCL

  %% ========= Utilities =========
  subgraph UTIL["Utils (src/utils/)"]
    TIME["time.py
ISO<->ms helpers, tz-safe"]
    BATCH["batching.py
chunking + safe batching"]
  end

  SYNC --> TIME
  SYNC --> BATCH
  SYNC --> QUERIES
  TSTATS --> TIME
  ASTATS --> TIME
  ALLPL --> BATCH
  ARTPL --> BATCH
  YEARPL --> BATCH

  %% ========= One-time OAuth bootstrap =========
  subgraph BOOT["One-time Setup"]
    BOOTPY["scripts/bootstrap_oauth.py
gets refresh token / cache token"]
    SPAPP["Spotify Developer App
(client id/secret, redirect URI)"]
    BOOTPY <--> SPAPP
    BOOTPY --> CFG
  end

  %% ========= Storage =========
  subgraph DATA["Data/"]
    DBFILE["data/spotify.db"]
    LOGS["data/logs/"]
  end

  CONN --> DBFILE
  LOG --> LOGS
