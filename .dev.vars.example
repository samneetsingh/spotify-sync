# Local secrets for `wrangler dev` and the scripts in scripts/. Copy to .dev.vars (gitignored).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Loopback redirect registered in the Spotify app, used by `npm run token`.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Only for calling /sync-full; any long random string (also set with `wrangler secret put`).
SYNC_FULL_SECRET=
# Optional: the digests' AI editor (also needs AI_EDITOR = "on"). Keep blank to leave it off.
OPENAI_API_KEY=
